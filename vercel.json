{
  "redirects": [
    {
      "source": "/pages/about",
      "destination": "/factory",
      "permanent": true
    },
    {
      "source": "/about-factory",
      "destination": "/factory",
      "permanent": true
    },
    {
      "source": "/factory/certificates",
      "destination": "/certifications",
      "permanent": true
    },
    {
      "source": "/request-product-plan",
      "destination": "/contact",
      "permanent": false
    },
    {
      "source": "/sitemap-index.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/pages/about",
      "permanent": true
    },
    {
      "source": "/profile",
      "destination": "/about-factory",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/factory",
      "permanent": true
    },
    {
      "source": "/innovation",
      "destination": "/academy",
      "permanent": true
    },
    {
      "source": "/news",
      "destination": "/pages/news",
      "permanent": true
    },
    {
      "source": "/quality",
      "destination": "/quality-control",
      "permanent": true
    },
    {
      "source": "/advantages",
      "destination": "/about-factory",
      "permanent": true
    },
    {
      "source": "/customization",
      "destination": "/private-label",
      "permanent": true
    },
    {
      "source": "/region/:country",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/disposable-pet-pads",
      "destination": "/products/pet-training-pads",
      "permanent": true
    },
    {
      "source": "/products/custom-pet-waste-bags",
      "destination": "/products/garbage-bags",
      "permanent": true
    },
    {
      "source": "/products/pet-care-pad-glove-wipes",
      "destination": "/products/disposable-cleaning-products",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/images/certificates/BSCI-social-compliance-audit.webp",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"BSCI-social-compliance-audit.webp\""
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/rss.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:path((?!api/|assets/|images/|videos/|media/|generated-images/|.*\\.[^/]+$).+)",
      "destination": "/:path/index.html"
    }
  ]
}
